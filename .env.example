# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM — OpenRouter (https://openrouter.ai/keys)
OPENAI_API_KEY=sk-or-...
OPENAI_MODEL=openai/gpt-4o
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Other models you can use on OpenRouter:
# anthropic/claude-3.5-sonnet
# google/gemini-pro-1.5
# meta-llama/llama-3.1-70b-instruct (cheaper)

# Database
DATABASE_URL=postgresql+asyncpg://coderev:coderev@localhost:5432/coderev

# Redis / job queue
REDIS_URL=redis://localhost:6379/0

# Sandbox
SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_WORKSPACE_DIR=/tmp/coderev_sandboxes
SANDBOX_CPU_QUOTA=50000
SANDBOX_MEM_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=120

# App
SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
