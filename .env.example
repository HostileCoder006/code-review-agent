# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=

# LLM — OpenRouter (https://openrouter.ai/keys)
OPENAI_API_KEY=sk-or-...
OPENAI_MODEL=anthropic/claude-haiku-4-5
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Other models you can use on OpenRouter:
# anthropic/claude-3.5-sonnet
# openai/gpt-4o
# google/gemini-pro-1.5
# meta-llama/llama-3.1-70b-instruct (cheaper)

# Database — local PostgreSQL (native Windows install)
DATABASE_URL=postgresql+asyncpg://coderev:coderev@localhost:5432/coderev

# Redis — local Redis (native Windows install)
REDIS_URL=redis://localhost:6379/0

# Sandbox — isolated Python venv per test run (no Docker)
# Use an absolute Windows path, e.g. C:\Users\YourName\coderev_sandboxes
SANDBOX_WORKSPACE_DIR=C:\Users\YOUR_USERNAME\coderev_sandboxes
SANDBOX_TIMEOUT_SECONDS=120

# App
SECRET_KEY=change-me-to-something-random
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
